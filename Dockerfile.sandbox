FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Clone autoresearch and install deps
RUN git clone https://github.com/karpathy/autoresearch /workspace/autoresearch
WORKDIR /workspace/autoresearch
RUN uv sync

# Download TinyStories data + tokenizer (avoid cold-start cost)
RUN uv run prepare.py

# Configure git for commits during episodes
RUN git config user.email "rl-agent@autoresearch" && \
    git config user.name "RL Agent"

CMD ["sleep", "infinity"]
